PORT=3000
HOST=0.0.0.0
MONGO_USERNAME=wiki
MONGO_PASSWORD=replace-with-a-long-random-password
MONGO_DB=nursing_wiki
# Percent-encode special characters in credentials inside this URI.
MONGO_URL=mongodb://wiki:replace-with-a-long-random-password@mongo:27017/nursing_wiki?authSource=admin
REDIS_URL=redis://redis:6379
ELASTICSEARCH_URL=http://elasticsearch:9200
OBJECT_ROOT=/data/objects
JWT_SECRET=replace-with-at-least-32-random-bytes
ADMIN_USERNAME=owner
ADMIN_PASSWORD=replace-with-a-unique-long-password
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LOG_LEVEL=info

# SMTP for client email verification. Use port 465 + true, or STARTTLS 587 + false.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
